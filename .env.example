# Optional public JSON POST endpoint. Empty means honest local-only preview mode.
# A successful HTTP 2xx response is required. Configure server validation, CORS,
# spam protection, and data retention before collecting real customer details.
# Never put private keys or secrets in VITE_ variables.
VITE_LEAD_ENDPOINT=

# Opt in to animated navbar scroll during local development, even with Reduce Motion.
# Ignored by production builds. Keep false unless explicitly previewing motion.
VITE_PREVIEW_SMOOTH_SCROLL=false
